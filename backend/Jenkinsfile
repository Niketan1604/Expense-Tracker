pipeline {
  agent any

  options {
    buildDiscarder(logRotator(numToKeepStr: '3'))
  }

  environment {
    APP_NAME       = 'expense-tracker'
    AWS_REGION     = 'ap-south-1'
    AWS_ACCOUNT_ID = credentials('aws-account-id')
    NODE_OPTIONS   = '--max-old-space-size=2048'
  }

  stages {

    // ─────────────────────────────────────────────────────────────
    // STAGE 1 — Checkout
    // ─────────────────────────────────────────────────────────────
    stage('Checkout') {
      steps {
        checkout([
          $class: 'GitSCM',
          branches: [[name: "*/${env.BRANCH_NAME}"]],
          userRemoteConfigs: [[
            url: 'git@github.com:Niketan1604/Expense-Tracker.git',
            credentialsId: 'github-ssh-key'
          ]]
        ])
        script {
          env.ENV_NAME = env.BRANCH_NAME == 'main' ? 'prod' : 'dev'
          env.DEPLOY_ROLE_ARN = "arn:aws:iam::${env.AWS_ACCOUNT_ID}:role/${env.APP_NAME}-${env.ENV_NAME}-jenkins-deploy-role"
          echo "Branch:      ${env.BRANCH_NAME}"
          echo "Environment: ${env.ENV_NAME}"
        }
      }
    }

    // ─────────────────────────────────────────────────────────────
    // STAGE 2 — Assume IAM Role
    // ─────────────────────────────────────────────────────────────
    stage('Assume Role') {
      steps {
        script {
          def creds = sh(
            script: """
              aws sts assume-role \
                --role-arn ${env.DEPLOY_ROLE_ARN} \
                --role-session-name jenkins-backend-\$(date +%s) \
                --duration-seconds 3600 \
                --query 'Credentials.[AccessKeyId,SecretAccessKey,SessionToken]' \
                --output text
            """,
            returnStdout: true
          ).trim().split('\\s+')

          env.AWS_ACCESS_KEY_ID     = creds[0]
          env.AWS_SECRET_ACCESS_KEY = creds[1]
          env.AWS_SESSION_TOKEN     = creds[2]

          sh 'aws sts get-caller-identity'
        }
      }
    }

    // ─────────────────────────────────────────────────────────────
    // STAGE 3 — Install Dependencies
    // npm ci installs exact versions from package-lock.json.
    // Ensures every pipeline run uses identical dependency versions.
    // ─────────────────────────────────────────────────────────────
    stage('Install Dependencies') {
      steps {
        dir('backend') {
          sh 'npm ci'
        }
      }
    }

    // ─────────────────────────────────────────────────────────────
    // STAGE 4 — TypeScript Type Check
    // Checks for type errors without emitting any output files.
    // Faster than a full build — catches errors early.
    // --noEmit means nothing is written to disk, just validation.
    // ─────────────────────────────────────────────────────────────
    stage('Type Check') {
      steps {
        dir('backend') {
          sh 'npx tsc --noEmit'
        }
      }
    }

    // ─────────────────────────────────────────────────────────────
    // STAGE 5 — Lint
    // ESLint checks code quality and catches common mistakes.
    // Fails pipeline if any error-level lint rules are violated.
    // ─────────────────────────────────────────────────────────────
    stage('Lint') {
      steps {
        dir('backend') {
          sh 'npx eslint "src/**/*.ts" --max-warnings=0'
        }
      }
    }

    // ─────────────────────────────────────────────────────────────
    // STAGE 6 — Unit Tests
    // --passWithNoTests allows pipeline to pass while tests are
    // still being written. Remove once tests exist.
    // ─────────────────────────────────────────────────────────────
    stage('Unit Tests') {
      steps {
        dir('backend') {
          sh 'npx jest --ci --passWithNoTests'
        }
      }
    }

    // ─────────────────────────────────────────────────────────────
    // STAGE 7 — Security Audit
    // Scans dependencies for known CVEs.
    // Only fails on HIGH or CRITICAL severity vulnerabilities.
    // ─────────────────────────────────────────────────────────────
    stage('Security Audit') {
      steps {
        dir('backend') {
          sh 'npm audit --audit-level=high'
        }
      }
    }

    // ─────────────────────────────────────────────────────────────
    // STAGE 8 — SAM Validate
    // Validates template.yaml syntax and resource references.
    // --lint also checks for best practice warnings.
    // ─────────────────────────────────────────────────────────────
    stage('SAM Validate') {
      steps {
        dir('backend') {
          sh "sam validate --region ${env.AWS_REGION} --lint"
        }
      }
    }

    // ─────────────────────────────────────────────────────────────
    // STAGE 9 — SAM Build
    // Compiles TypeScript Lambda handlers using esbuild.
    // --parallel builds all functions simultaneously.
    // esbuild bundles each handler + shared/ imports into a
    // single minified JS file per function.
    // ─────────────────────────────────────────────────────────────
    stage('SAM Build') {
      steps {
        dir('backend') {
          sh 'sam build --parallel'
        }
      }
    }

    // ─────────────────────────────────────────────────────────────
    // STAGE 10 — Approval Gate (prod only)
    // dev deploys automatically — no gate needed.
    // prod requires manual approval to prevent accidental deploys.
    // ─────────────────────────────────────────────────────────────
    stage('Approval') {
      when {
        expression { return env.ENV_NAME == 'prod' }
      }
      steps {
        timeout(time: 30, unit: 'MINUTES') {
          input(
            message: "Deploy backend to PRODUCTION?",
            ok: 'Yes, deploy'
          )
        }
      }
    }

    // ─────────────────────────────────────────────────────────────
    // STAGE 11 — SAM Deploy
    //
    // --stack-name        CloudFormation stack name
    // --capabilities      Required for IAM role creation
    // --force-upload      Always uploads all artifacts regardless
    //                     of changes — ensures pipeline is source
    //                     of truth, overrides any console changes
    // --no-fail-on-empty-changeset
    //                     Don't fail if nothing changed
    // --parameter-overrides
    //                     Only AppName + EnvName are declared as
    //                     Parameters in template.yaml. Everything
    //                     else is resolved via {{resolve:ssm:...}}
    //                     directly in the template at deploy time.
    //
    // SSM export (api-endpoint) is handled automatically by the
    // ApiEndpointParam resource in template.yaml — no extra stage
    // needed here.
    // ─────────────────────────────────────────────────────────────
    stage('SAM Deploy') {
      steps {
        dir('backend') {
          sh """
            sam deploy \
              --stack-name ${env.APP_NAME}-${env.ENV_NAME}-backend \
              --region ${env.AWS_REGION} \
              --capabilities CAPABILITY_IAM \
              --force-upload \
              --no-fail-on-empty-changeset \
              --parameter-overrides \
                AppName=${env.APP_NAME} \
                EnvName=${env.ENV_NAME}
          """
        }
      }
    }

    // ─────────────────────────────────────────────────────────────
    // STAGE 12 — Smoke Test
    // Reads API endpoint from SSM (written by ApiEndpointParam
    // resource in template.yaml during sam deploy).
    // Hits /health to verify API Gateway + Lambda are responding.
    // -f flag makes curl fail with non-zero exit on HTTP errors.
    // ─────────────────────────────────────────────────────────────
    stage('Smoke Test') {
      steps {
        script {
          def apiEndpoint = sh(
            script: """
              aws ssm get-parameter \
                --name "/${env.APP_NAME}/${env.ENV_NAME}/backend/api-endpoint" \
                --region ${env.AWS_REGION} \
                --query 'Parameter.Value' \
                --output text
            """,
            returnStdout: true
          ).trim()

          echo "Hitting: ${apiEndpoint}/health"
          sh "curl -f ${apiEndpoint}/health"
        }
      }
    }

  }

  post {
    always {
      script {
        env.AWS_ACCESS_KEY_ID     = ''
        env.AWS_SECRET_ACCESS_KEY = ''
        env.AWS_SESSION_TOKEN     = ''
      }
      cleanWs()
    }
    success {
      echo "✓ Backend deploy to ${env.ENV_NAME} succeeded"
    }
    failure {
      echo "✗ Backend deploy to ${env.ENV_NAME} failed"
    }
  }

}
